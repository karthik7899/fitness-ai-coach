# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://aura:aura@127.0.0.1:5432/aura

# Coach agent. Free API key from https://aistudio.google.com/apikey
# Note: on the free tier Google may use prompts and responses to improve its
# products, including human review. A paid key excludes your data from training.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Strava: https://www.strava.com/settings/api
# Set the Authorization Callback Domain to localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Google Drive, used only to pull the Health Connect scheduled export.
# Desktop-app OAuth client JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json

# Display preference only. Storage is always SI (kg / m / s).
UNIT_SYSTEM=metric

# How often the background sync runs each connected adapter.
SYNC_INTERVAL_MINUTES=60

# Folders owned by other apps, read in place and never modified — point these at
# the FitNotes and Gadgetbridge automatic-backup targets and import is hands-off.
# Comma-separated. Also settable in the Settings tab, which overrides this.
WATCH_DIRS=
