# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://aura:aura@127.0.0.1:5432/aura

# Coach agent. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Strava: https://www.strava.com/settings/api
# Set the Authorization Callback Domain to localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Google Drive, used only to pull the Health Connect scheduled export.
# Desktop-app OAuth client JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json

# Display preference only. Storage is always SI (kg / m / s).
UNIT_SYSTEM=metric

# How often the background sync runs each connected adapter.
SYNC_INTERVAL_MINUTES=60
